# Quadlet Podman du récepteur de résultats passifs par SSH : voir
# doc/admin/recettes/passif-ssh.md. Optionnel : à installer seulement si des
# machines envoient leurs résultats (etc/passive/authorized_keys requis).
[Unit]
Description=Shinken passive-ssh (résultats passifs envoyés par SSH)
Wants=network-online.target shinken-broker.service
After=network-online.target shinken-broker.service

[Container]
ContainerName=shinken-passive-ssh
Image=localhost/shinken:2.4.3
Pull=never
Exec=passive-ssh
Network=shinken.network
NetworkAlias=passive-ssh
Environment=TZ=Europe/Paris
Environment=SHINKEN_LIVESTATUS=broker:50000
PublishPort=2222:2222
Volume=%h/shinken/etc:/etc/shinken:ro,z
# Volume propre (HOME du compte sshd, clé d'hôte), jamais partagé
Volume=shinken-passive-ssh.volume:/var/lib/shinken:z
Volume=shinken-logs.volume:/var/log/shinken:z
NoNewPrivileges=true
DropCapability=ALL
HealthCmd=python -c "import socket; socket.create_connection(('127.0.0.1', 2222), 3)"
HealthInterval=30s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
