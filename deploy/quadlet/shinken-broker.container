# Quadlet Podman du daemon broker : voir deploy/README.md
[Unit]
Description=Shinken broker (Livestatus, interface de statut)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=shinken-broker
Image=localhost/shinken:2.4.3
Pull=never
Exec=broker
Network=shinken.network
# Nom DNS attendu par la configuration réécrite par l'entrypoint
NetworkAlias=broker
Environment=TZ=Europe/Paris
Environment=SHINKEN_CONTAINER_DNS=1
Environment=SHINKEN_STATUS_WEBUI=1
Environment=SHINKEN_MODULES_DIR=/usr/local/lib/shinken/modules
Volume=%h/shinken/etc:/etc/shinken:ro,z
Volume=shinken-data.volume:/var/lib/shinken:z
Volume=shinken-logs.volume:/var/log/shinken:z
NoNewPrivileges=true
DropCapability=ALL
PublishPort=127.0.0.1:8081:8080
PublishPort=127.0.0.1:50000:50000
# Sain seulement si le daemon ET Livestatus répondent
HealthCmd=shinken-healthcheck --daemon broker --livestatus --timeout 5
HealthStartPeriod=90s
# Pas de Notify=healthy : une panne de Livestatus ne doit pas bloquer le
# démarrage du reste de la supervision (l'état reste visible dans podman ps).

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
