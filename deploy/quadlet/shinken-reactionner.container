# Quadlet Podman du daemon reactionner : voir deploy/README.md
[Unit]
Description=Shinken reactionner (notifications, event handlers)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=shinken-reactionner
Image=localhost/shinken:2.4.3
Pull=never
Exec=reactionner
Network=shinken.network
# Nom DNS attendu par la configuration réécrite par l'entrypoint
NetworkAlias=reactionner
Environment=TZ=Europe/Paris
Environment=SHINKEN_CONTAINER_DNS=1
Environment=SHINKEN_STATUS_WEBUI=1
Environment=SHINKEN_MODULES_DIR=/usr/local/lib/shinken/modules
Volume=%h/shinken/etc:/etc/shinken:ro,z
Volume=shinken-data.volume:/var/lib/shinken:z
Volume=shinken-logs.volume:/var/log/shinken:z
NoNewPrivileges=true
DropCapability=ALL
Volume=%h/shinken/plugins-local:/usr/local/lib/shinken/plugins-local:ro,z
# HEALTHCHECK de l'image (le daemon répond sur son port) ; l'unité n'est
# considérée démarrée qu'une fois le conteneur sain.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
