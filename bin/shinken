"""Shinken command line interface.

The commands themselves are provided by ``cli/<name>/cli.py`` plugins, which
expose an ``exports`` dict (keyword -> function, arguments, description) and
optionally a ``configurations`` dict merged into ``~/.shinken.ini``.

Examples::

    shinken --init            # create/refresh ~/.shinken.ini
    shinken --list            # list available commands
    shinken -h search         # help of one command
    shinken search linux      # run one command
    shinken                   # interactive prompt
"""

import argparse
import configparser
import importlib.util
import os
import shlex
import signal
import sys


def _bootstrap_shinken():
    """Import shinken, falling back to the source checkout next to this script."""
    try:
        import shinken  # noqa: F401
    except ImportError:
        here = os.path.dirname(os.path.abspath(__file__))
        for root in (os.path.dirname(here), os.getcwd(), os.path.dirname(os.getcwd())):
            if os.path.isfile(os.path.join(root, "shinken", "__init__.py")):
                sys.path.insert(0, root)
                break
        import shinken  # noqa: F401


_bootstrap_shinken()

from shinken.bin import VERSION  # noqa: E402
from shinken.log import logger, nagFormatter  # noqa: E402

logger.setLevel("WARNING")
for _handler in logger.handlers:
    _handler.setFormatter(nagFormatter)


def sig_handler(signalnum, frame):
    """Exit quietly on SIGTERM/SIGINT."""
    sys.exit(0)


signal.signal(signal.SIGTERM, sig_handler)
signal.signal(signal.SIGINT, sig_handler)

CONFIG = {}
DEFAULT_CFG = os.path.expanduser("~/.shinken.ini")
_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Where the cli/ plugins may live when ~/.shinken.ini does not say otherwise:
# source checkout first, then the container image layout.
CLI_DIR_CANDIDATES = (
    os.path.join(os.path.dirname(_SCRIPT_DIR), "cli"),
    "/usr/local/lib/shinken/cli",
    "/var/lib/shinken/cli",
)


def cprint(text, color=None, end="\n"):
    """Print text, in green when stdout is a terminal."""
    if color == "green" and sys.stdout.isatty():
        text = "\033[32m%s\033[0m" % text
    print(text, end=end)


class Dummy:
    """Brok sink: the CLI has no broker to forward log broks to."""

    def add(self, obj):
        pass


logger.load_obj(Dummy())


class ConfigParserWithComments(configparser.RawConfigParser):
    """RawConfigParser able to write one comment per section."""

    def optionxform(self, optionstr):
        return optionstr

    def add_comment(self, section, comment):
        if not comment.startswith("#"):
            comment = "#" + comment
        self.set(section, ";%s" % comment, None)

    def write(self, fp, space_around_delimiters=True):
        for section in self._sections:
            fp.write("[%s]\n" % section)
            for key, value in self._sections[section].items():
                if key.startswith(";") and value is None:
                    fp.write("%s\n" % key[1:])
                else:
                    fp.write("%s = %s\n" % (key, str(value).replace("\n", "\n\t")))
            fp.write("\n")


def default_cli_dir():
    for candidate in CLI_DIR_CANDIDATES:
        if os.path.isdir(candidate):
            return candidate
    return CLI_DIR_CANDIDATES[-1]


class CLICommander:
    """Load cli/ plugins and dispatch commands to them."""

    def __init__(self, config, cfg, opts):
        self.ini_defaults = {
            "paths": {
                "comment": "# Set the paths according to your setup.",
                "values": [
                    ("etc", "/etc/shinken"), ("lib", "/var/lib/shinken"),
                    ("share", "%(lib)s/share"), ("cli", default_cli_dir()),
                    ("packs", "%(etc)s/packs"), ("modules", "/usr/local/lib/shinken/modules"),
                    ("doc", "%(lib)s/doc"), ("inventory", "%(lib)s/inventory"),
                    ("libexec", "/usr/local/lib/shinken/libexec"),
                ],
            },
            "shinken.io": {
                "comment": "# Options for the shinken.io package repository. "
                           "proxy: curl style (http://user:password@server:3128); "
                           "proxy_socks5: server:1080; api_key: needed to publish.",
                "values": [("proxy", ""), ("proxy_socks5", ""), ("api_key", "")],
            },
        }
        self.keywords = {}
        self.cfg = cfg
        self.config = config
        self.init_done = False
        self.completion_matches = []
        self.load_cli_mods(opts)

    def cli_dir(self):
        return self.config.get("paths", {}).get("cli") or default_cli_dir()

    def load_cli_mods(self, opts):
        cli_mods_dir = os.path.abspath(self.cli_dir())
        if not os.path.isdir(cli_mods_dir):
            if not opts.do_init:
                logger.error("Cannot load cli commands: directory %s not found "
                             "(set [paths] cli in %s)", cli_mods_dir, opts.iniconfig)
            return
        self.init_done = True
        logger.debug("Loading cli commands from %s", cli_mods_dir)

        new_config_param = False
        for name in sorted(os.listdir(cli_mods_dir)):
            mod_dir = os.path.join(cli_mods_dir, name)
            mod_file = os.path.join(mod_dir, "cli.py")
            if not os.path.isfile(mod_file):
                continue
            sys.path.append(mod_dir)
            try:
                spec = importlib.util.spec_from_file_location("shinken_cli_%s" % name, mod_file)
                module = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(module)
            except Exception as exp:  # a broken plugin must not kill the CLI
                logger.error("Cannot load cli module %s: %s", mod_file, exp)
                continue
            module.CONFIG = self.config
            for func, desc in getattr(module, "exports", {}).items():
                for keyword in desc.get("keywords", []):
                    self.keywords[keyword] = {
                        "f": func,
                        "args": desc.get("args", []),
                        "description": desc.get("description", ""),
                        "came_from": name,
                    }
            for section, entry in getattr(module, "configurations", {}).items():
                if section not in self.config:
                    self.ini_defaults[section] = entry
                    new_config_param = True
                    continue
                self.ini_defaults.setdefault(section, entry)
                defaults = self.ini_defaults[section].setdefault("values", [])
                for prop, value in entry.get("values", []):
                    if prop not in self.config[section]:
                        defaults.append((prop, value))
                        new_config_param = True

        if new_config_param and self.cfg is not None:
            logger.info("New module parameter detected, updating the ini file")
            write_ini_file(self.cfg, self, opts)

    def loop(self):
        if not self.init_done:
            logger.error("CLI loading not done: missing configuration data. Please run --init")
            return
        import atexit
        import readline

        readline.parse_and_bind("tab: complete")
        readline.set_completer(self.complete)
        readline.parse_and_bind("set editing-mode emacs")
        histfile = os.path.join(os.path.expanduser("~"), ".shinken.history")
        try:
            readline.read_history_file(histfile)
        except OSError:
            pass
        atexit.register(readline.write_history_file, histfile)

        while True:
            try:
                line = input("> ")
            except EOFError:
                print("")
                break
            line = line.strip()
            if line in ("quit", "exit", "bye", "sayonara"):
                break
            if not line:
                continue
            if line.startswith("!"):
                os.system(line[1:])
                continue
            self.one_loop(shlex.split(line))

    def one_loop(self, command_args):
        if not self.init_done:
            logger.error("CLI loading not done: missing configuration data. Please run --init")
            return 1
        keyword = command_args.pop(0)
        mod = self.keywords.get(keyword)
        if mod is None:
            logger.error("Unknown command %s (see shinken --list)", keyword)
            return 1

        command_parser = argparse.ArgumentParser(prog="shinken %s" % keyword,
                                                 description=mod["description"])
        command_parser.add_argument("args", nargs="*")
        for arg in mod.get("args", []):
            name = arg.get("name")
            if not name or not name.startswith("-"):
                continue
            dest = name.lstrip("-").replace("-", "_")
            if arg.get("type") == "bool":
                command_parser.add_argument(name, action="store_true", dest=dest,
                                            help=arg.get("description", ""))
            else:
                command_parser.add_argument(name, dest=dest, default=arg.get("default"),
                                            help=arg.get("description", ""))
        cmd_opts = vars(command_parser.parse_args(command_args))
        positional = cmd_opts.pop("args")
        try:
            result = mod["f"](*positional, **cmd_opts)
        except OSError as exp:
            logger.error("%s: %s", keyword, exp)
            return 2
        return 0 if result in (None, True) else result

    def complete(self, text, state):
        if state == 0:
            self.completion_matches = [k for k in sorted(self.keywords)
                                       if k.startswith(text.strip())]
        try:
            return self.completion_matches[state]
        except IndexError:
            return None


def write_ini_file(cfg, cli, opts):
    new_cfg = ConfigParserWithComments(interpolation=None)
    modify = False
    if cfg is None:
        cfg = configparser.RawConfigParser()
    for section in cfg.sections():
        if not new_cfg.has_section(section):
            new_cfg.add_section(section)
        for key, value in cfg.items(section, raw=True):
            new_cfg.set(section, key, value)

    for section, desc in cli.ini_defaults.items():
        if not new_cfg.has_section(section):
            print("Creating ini section", section)
            new_cfg.add_section(section)
            modify = True
        if desc.get("comment"):
            new_cfg.add_comment(section, desc["comment"])
        for key, value in desc.get("values", []):
            if not cfg.has_option(section, key):
                new_cfg.set(section, key, value)
                modify = True
    if modify:
        print("Saving the new configuration file", opts.iniconfig)
        with open(opts.iniconfig, "w", encoding="utf-8") as configfile:
            new_cfg.write(configfile)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="shinken", add_help=False,
        description="Shinken command line interface (packages, documentation, inventory).",
        epilog="Run 'shinken --list' to see the available commands and "
               "'shinken -h <command>' for the help of one command.")
    parser.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    parser.add_argument("--proxy", help="Proxy URI, like http://user:password@proxy-server:3128")
    parser.add_argument("--proxy_socks5", "--proxy-socks5", dest="proxy_socks5",
                        help="Socks5 proxy URI, like server:1080")
    parser.add_argument("-A", "--api-key", dest="api_key",
                        help="API key used to publish packages on shinken.io")
    parser.add_argument("-l", "--list", action="store_true", dest="do_list",
                        help="List available commands")
    parser.add_argument("--init", action="store_true", dest="do_init",
                        help="Initialize/refill your shinken.ini file (default %s)" % DEFAULT_CFG)
    parser.add_argument("-D", action="store_true", dest="do_debug", help="Enable debug mode")
    parser.add_argument("-c", "--config", dest="iniconfig", default=DEFAULT_CFG,
                        help="Path to your shinken.ini file. Default: %s" % DEFAULT_CFG)
    parser.add_argument("-v", action="store_true", dest="do_verbose", help="Be more verbose")
    parser.add_argument("-h", "--help", action="store_true", dest="do_help", help="Print help")
    return parser


def main(custom_args=None):
    argv = list(sys.argv[1:] if custom_args is None else custom_args)
    parser = build_parser()
    opts, _ = parser.parse_known_args(argv)

    if opts.do_verbose:
        logger.setLevel("INFO")
    if opts.do_debug:
        logger.setLevel("DEBUG")

    cfg = None
    if os.path.exists(opts.iniconfig):
        cfg = configparser.ConfigParser()
        cfg.read(opts.iniconfig, encoding="utf-8")
        for section in cfg.sections():
            CONFIG.setdefault(section, {}).update(cfg.items(section))
    shinken_io = CONFIG.setdefault("shinken.io", {})
    if opts.api_key:
        shinken_io["api_key"] = opts.api_key
    shinken_io["proxy"] = opts.proxy or shinken_io.get("proxy") or None
    shinken_io["proxy_socks5"] = opts.proxy_socks5 or shinken_io.get("proxy_socks5") or None

    cli = CLICommander(CONFIG, cfg, opts)

    # Split argv: everything from the first known command keyword belongs to it.
    internal, command_args = argv, []
    for index, arg in enumerate(argv):
        if arg in cli.keywords:
            internal, command_args = argv[:index], argv[index:]
            break
    opts = parser.parse_args(internal)

    if opts.do_help:
        if not command_args:
            parser.print_help()
            return 0
        keyword = command_args[0]
        cprint(keyword, "green")
        print("    %s" % cli.keywords[keyword]["description"])
        for arg in cli.keywords[keyword]["args"]:
            cprint("\t%s" % arg.get("name", ""), "green", end="")
            print(": %s" % arg.get("description", ""))
        return 0

    if opts.do_list:
        if not cli.init_done:
            return 1
        print("Available commands:")
        by_module = {}
        for keyword, mod in cli.keywords.items():
            by_module.setdefault(mod["came_from"], []).append((keyword, mod))
        for mod_name in sorted(by_module):
            print("%s:" % mod_name)
            for keyword, mod in sorted(by_module[mod_name], key=lambda e: e[0]):
                cprint("\t%s " % keyword, "green", end="")
                print(": %s" % mod["description"])
        return 0

    if opts.do_init:
        write_ini_file(cfg, cli, opts)
        return 0

    if not command_args:
        cli.loop()
        return 0
    return cli.one_loop(command_args)


if __name__ == "__main__":
    sys.exit(main())
