#!/usr/bin/env python3
"""shinken-healthcheck: check that Shinken really works.

Two modes:

* Daemon probe (``--daemon ROLE``, used by the container HEALTHCHECK):
  calls ``GET /ping`` on the HTTP port of the daemon and expects ``pong``;
  with ``--livestatus`` it also sends ``GET status`` to Livestatus. Exit 0 when
  everything answers, 1 otherwise, with one line explaining what failed.
  ``--daemon auto`` finds the role from the container command line
  (``shinken-entrypoint <role>``).

* Status report (default): connect to Livestatus and print the current state
  of every configured host and service.

No dependency beyond the Python 3 standard library on purpose: this
script is meant to run both from inside a Shinken container and from the
host (or any machine with network access to the ports), without
needing the shinken package installed.
"""

import argparse
import json
import os
import socket
import ssl
import sys
import time
import urllib.error
import urllib.request

# Default HTTP ports of the daemons (etc/daemons/*.ini, etc/*/*-master.cfg).
DAEMON_PORTS = {
    "scheduler": 7768,
    "reactionner": 7769,
    "arbiter": 7770,
    "poller": 7771,
    "broker": 7772,
    "receiver": 7773,
}


HOST_STATE_NAMES = {0: "UP", 1: "DOWN", 2: "UNREACHABLE"}
SERVICE_STATE_NAMES = {0: "OK", 1: "WARNING", 2: "CRITICAL", 3: "UNKNOWN"}

OK_LABELS = {"UP", "OK"}

COLORS = {
    "OK": "\033[32m",
    "UP": "\033[32m",
    "WARNING": "\033[33m",
    "CRITICAL": "\033[31m",
    "DOWN": "\033[31m",
    "UNKNOWN": "\033[35m",
    "UNREACHABLE": "\033[35m",
    "PENDING": "\033[90m",
}
RESET = "\033[0m"


def livestatus_query(host, port, query, timeout):
    with socket.create_connection((host, port), timeout=timeout) as sock:
        sock.sendall(query.encode("utf-8"))
        sock.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = sock.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
    raw = b"".join(chunks).decode("utf-8", "replace").strip()
    return json.loads(raw) if raw else []


def detect_role(cmdline_path="/proc/1/cmdline"):
    """Return the daemon role from the container command line, or None."""
    role = os.environ.get("SHINKEN_ROLE")
    if role in DAEMON_PORTS:
        return role
    try:
        with open(cmdline_path, "rb") as handle:
            args = handle.read().decode("utf-8", "replace").split("\0")
    except OSError:
        return None
    for arg in args:
        name = os.path.basename(arg)
        if name in DAEMON_PORTS:
            return name
        if name.startswith("shinken-") and name[len("shinken-"):] in DAEMON_PORTS:
            return name[len("shinken-"):]
    return None


def ping_daemon(host, port, timeout, use_ssl=False):
    """Call /ping on a daemon; return None when healthy, else an error string."""
    scheme = "https" if use_ssl else "http"
    url = "%s://%s:%d/ping" % (scheme, host, port)
    context = None
    if use_ssl:
        # Daemons usually run with a private CA: only liveness matters here.
        context = ssl._create_unverified_context()  # noqa: S323
    try:
        with urllib.request.urlopen(url, timeout=timeout, context=context) as resp:
            body = resp.read(256).decode("utf-8", "replace")
    except (OSError, urllib.error.URLError) as exp:
        return "%s unreachable: %s" % (url, getattr(exp, "reason", exp))
    if "pong" not in body:
        return "%s answered %r instead of pong" % (url, body[:80])
    return None


def check_livestatus(host, port, timeout):
    """Send GET status to Livestatus; return None when healthy, else an error."""
    try:
        rows = livestatus_query(host, port,
                                "GET status\nColumns: program_version\n"
                                "OutputFormat: json\n\n", timeout)
    except (OSError, ValueError) as exp:
        return "livestatus %s:%d unreachable: %s" % (host, port, exp)
    if not rows:
        return "livestatus %s:%d returned an empty status" % (host, port)
    return None


def probe(args):
    role = args.daemon
    if role == "auto":
        role = detect_role()
        if role is None:
            print("UNKNOWN - cannot detect the daemon role, use --daemon ROLE")
            return 1
    port = args.daemon_port or DAEMON_PORTS[role]
    errors = []
    error = ping_daemon(args.daemon_host, port, args.timeout, args.ssl)
    if error:
        errors.append(error)
    if args.livestatus:
        error = check_livestatus(args.host, args.port, args.timeout)
        if error:
            errors.append(error)
    if errors:
        print("CRITICAL - %s: %s" % (role, "; ".join(errors)))
        return 1
    extra = " and livestatus %s:%d" % (args.host, args.port) if args.livestatus else ""
    print("OK - %s answers on port %d%s" % (role, port, extra))
    return 0


def colorize(label, use_color):
    if not use_color:
        return label
    return "%s%s%s" % (COLORS.get(label, ""), label, RESET)


def state_label(state_names, state, has_been_checked):
    if not has_been_checked:
        return "PENDING"
    return state_names.get(state, "UNKNOWN")


def staleness_note(now, last_check, has_been_checked, stale_after):
    if not stale_after or not has_been_checked:
        return "", False
    delta = now - last_check
    if delta > stale_after:
        return "  (dernier check il y a %ds, seuil %ds)" % (int(delta), stale_after), True
    return "", False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default="127.0.0.1",
                         help="Livestatus host (default: 127.0.0.1)")
    parser.add_argument("--port", type=int, default=50000,
                         help="Livestatus port (default: 50000)")
    parser.add_argument("--timeout", type=float, default=5,
                         help="Socket timeout in seconds (default: 5)")
    parser.add_argument("--stale-after", type=int, default=0,
                         help="Flag a check as stale if it hasn't run in N "
                              "seconds (0 = disabled, default)")
    parser.add_argument("--no-color", action="store_true",
                         help="Disable ANSI colors even on a TTY")
    parser.add_argument("--quiet", action="store_true",
                         help="Only print problems, not every OK line")
    parser.add_argument("--exit-nonzero-on-problem", action="store_true",
                         help="Exit 1 if anything isn't OK/UP, PENDING, or stale")
    probe_group = parser.add_argument_group("daemon probe (container healthcheck)")
    probe_group.add_argument("--daemon", choices=sorted(DAEMON_PORTS) + ["auto"],
                             help="Probe this daemon's /ping instead of printing the status")
    probe_group.add_argument("--daemon-host", default="127.0.0.1",
                             help="Daemon address (default: 127.0.0.1)")
    probe_group.add_argument("--daemon-port", type=int, default=0,
                             help="Daemon HTTP port (default: standard port of the role)")
    probe_group.add_argument("--ssl", action="store_true",
                             help="Daemons use use_ssl=1 (https, certificate not verified)")
    probe_group.add_argument("--livestatus", action="store_true",
                             help="With --daemon: also require Livestatus (--host/--port)")
    args = parser.parse_args()

    if args.daemon:
        sys.exit(probe(args))

    use_color = (not args.no_color) and sys.stdout.isatty()
    now = time.time()
    problems = 0

    try:
        hosts = livestatus_query(
            args.host, args.port,
            "GET hosts\n"
            "Columns: name state plugin_output has_been_checked last_check\n"
            "OutputFormat: json\n\n",
            args.timeout,
        )
        services = livestatus_query(
            args.host, args.port,
            "GET services\n"
            "Columns: host_name description state plugin_output "
            "has_been_checked last_check\n"
            "OutputFormat: json\n\n",
            args.timeout,
        )
    except (OSError, ValueError) as exp:
        print("ERREUR : impossible d'interroger Livestatus sur %s:%d (%s)"
              % (args.host, args.port, exp), file=sys.stderr)
        sys.exit(2)

    print("== Hosts ==")
    for name, state, output, checked, last_check in hosts:
        label = state_label(HOST_STATE_NAMES, state, checked)
        note, stale = staleness_note(now, last_check, checked, args.stale_after)
        is_problem = label not in OK_LABELS or label == "PENDING" or stale
        if is_problem:
            problems += 1
        if args.quiet and not is_problem:
            continue
        print("  %-30s %-22s %s%s" % (name, colorize(label, use_color), output, note))

    print("\n== Services ==")
    for host_name, desc, state, output, checked, last_check in services:
        label = state_label(SERVICE_STATE_NAMES, state, checked)
        note, stale = staleness_note(now, last_check, checked, args.stale_after)
        is_problem = label not in OK_LABELS or label == "PENDING" or stale
        if is_problem:
            problems += 1
        if args.quiet and not is_problem:
            continue
        print("  %-45s %-22s %s%s" % ("%s/%s" % (host_name, desc),
                                        colorize(label, use_color), output, note))

    print("\n%d host(s), %d service(s), %d probleme(s) detecte(s)."
          % (len(hosts), len(services), problems))

    if args.exit_nonzero_on_problem and problems:
        sys.exit(1)


if __name__ == "__main__":
    main()
