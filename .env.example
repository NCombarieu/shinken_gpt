# Réglages locaux de compose.yaml : copiez ce fichier en .env et adaptez-le.
# .env n'est pas versionné (voir .gitignore).

# Fuseau horaire des daemons : timeperiods, notification_period, downtimes et
# horodatage des logs en dépendent. Doit être celui de l'ancien serveur.
TZ=Europe/Paris

# Version de l'image : localhost/shinken:<SHINKEN_VERSION>. Gardez l'image
# précédente pour revenir en arrière (SHINKEN_VERSION=<ancienne> podman-compose up -d).
SHINKEN_VERSION=2.4.3
# Révision git inscrite dans les labels OCI (git rev-parse --short HEAD)
SHINKEN_VCS_REF=unknown

# Interface d'écoute des ports publiés par le broker. 127.0.0.1 par défaut :
# ne publiez jamais Livestatus (sans authentification) sur une interface publique.
SHINKEN_BIND=127.0.0.1
# Mini interface web de statut (port 8080 du conteneur broker)
SHINKEN_WEBUI_PORT=8081
# Livestatus (Thruk, shinken-healthcheck)
SHINKEN_LIVESTATUS_PORT=50000

# Pile de métriques expérimentale (podman-compose --profile experimental-metrics)
GRAFANA_VERSION=11.6.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-please
# Jeton d'API InfluxDB partagé avec Grafana (générez-le : openssl rand -hex 32)
INFLUXDB_ADMIN_TOKEN=change-me-please

# Le relais SMTP des notifications se règle dans etc/resource.d/notifications.cfg
# ($SMTP_HOST$, $SMTP_PORT$, $MAIL_FROM$).
