import cmd
import os
import sys
import time

try:
    import shinken
except ImportError:
    # Support running directly from a source checkout without installation.
    script_dir = os.path.abspath(os.path.dirname(__file__))
    for candidate in (
        os.path.realpath("."),
        os.path.realpath(".."),
        os.path.realpath(os.path.join(script_dir, "..", "..")),
    ):
        if os.path.isdir(os.path.join(candidate, "shinken")):
            sys.path.insert(0, candidate)
            break
    import shinken  # noqa: F401,E402

try:
    import shinken.pyro_wrapper as pyro
except ImportError:
    sys.exit("Shinken requires the Pyro5 module (pip package Pyro5). Please install it.")

from shinken.log import logger
from shinken.objects.arbiterlink import ArbiterLink


class Dummy:
    def add(self, obj):
        pass


logger.load_obj(Dummy())

sat_types = [
    "arbiter",
    "scheduler",
    "poller",
    "reactionner",
    "receiver",
    "broker",
]


def get_since(timestamp):
    if timestamp == 0:
        return "never"
    return "%ds ago" % int(time.time() - timestamp)


class ShinkenAdmin(cmd.Cmd):
    prompt = "> "

    def __init__(self):
        super().__init__()
        self.arb = None

    def look_connection(self):
        """Connect to the default arbiter if no connection exists."""
        if not self.arb:
            self.do_connect("")
        self.arb.ping()

    def emptyline(self):
        return None

    def do_connect(self, line):
        """Connect to an arbiter daemon: connect [host]:[port]."""
        line = line.strip()
        tokens = line.split(":")
        if not line:
            addr = "localhost"
            port = "7770"
        else:
            addr = tokens[0]
            port = tokens[1] if len(tokens) > 1 else "7770"

        print("Connection to %s:%s" % (addr, port))
        ArbiterLink.use_ssl = False
        self.arb = ArbiterLink(
            {"arbiter_name": "unnamed arbiter", "address": addr, "port": port}
        )
        self.arb.fill_default()
        self.arb.pythonize()
        self.arb.update_infos()
        print("Connection OK" if self.arb.reachable else "Connection problem")

    @staticmethod
    def _print_state_table(title, objects, name_attribute):
        separator = "+-------------------------------------------------------------------------------+"
        print(separator)
        print(
            "| {0:15} | {1:15} | {2:5} | {3:5} | {4:11} | {5:11} |".format(
                title, "address", "port", "alive", "reachable", "last_check"
            )
        )
        print(separator)
        for obj in objects:
            print(
                "| {0:15} | {1:15} | {2:5} | {3:5} | {4:11} | {5:11} |".format(
                    getattr(obj, name_attribute),
                    obj.address,
                    obj.port,
                    obj.alive,
                    obj.reachable,
                    get_since(obj.last_check),
                )
            )
        print(separator)

    def do_status(self, line):
        """Show the state of daemons known by the connected arbiter."""
        self.look_connection()
        if not self.arb.reachable:
            print("Cannot connect to the arbiter, bail out")
            return

        data = self.arb.get_all_states()
        self._print_state_table("Arbiter", data["arbiter"], "arbiter_name")
        self._print_state_table("Scheduler", data["scheduler"], "scheduler_name")
        self._print_state_table("Poller", data["poller"], "poller_name")
        self._print_state_table("Reactionner", data["reactionner"], "reactionner_name")
        self._print_state_table("Broker", data["broker"], "broker_name")
        self._print_state_table("Receiver", data["receiver"], "receiver_name")

    def do_getconf(self, line):
        """Display selected host configuration properties."""
        self.look_connection()
        if not self.arb.reachable:
            print("Cannot connect to the arbiter, bail out")
            return

        data = self.arb.get_objects_properties("hosts", "host_name", "check_interval")
        for values in data:
            print(" ".join(str(value) for value in values))

    def do_gethostname(self, line):
        """Return the local hostname."""
        import socket

        print(socket.gethostname())

    def do_EOF(self, line):  # noqa: N802 - cmd.Cmd command naming convention
        return self.do_quit("")

    def do_quit(self, line):
        print("")
        return True

    def do_easter(self, line):
        """Run one of the historical easter-egg helpers."""
        import shinken.easter as easter

        function = getattr(easter, line.strip(), None)
        if function:
            function()

    def do_showconfig(self, line):
        """Display daemon configuration: showconfig objecttype [objectname]."""
        from shinken.objects.brokerlink import BrokerLink
        from shinken.objects.pollerlink import PollerLink
        from shinken.objects.reactionnerlink import ReactionnerLink
        from shinken.objects.receiverlink import ReceiverLink
        from shinken.objects.schedulerlink import SchedulerLink

        if line in ("help", ""):
            print("Usage: showconfig objecttype [objectname]")
            print("Example: showconfig poller poller-1")
            return

        daemon_type = line
        self.look_connection()
        link_types = {
            "arbiter": (ArbiterLink, "arbiters"),
            "scheduler": (SchedulerLink, "schedulers"),
            "poller": (PollerLink, "pollers"),
            "broker": (BrokerLink, "brokers"),
            "reactionner": (ReactionnerLink, "reactionners"),
            "receiver": (ReceiverLink, "receivers"),
        }
        try:
            link_class, config_attribute = link_types[daemon_type]
        except KeyError:
            print("Unknown object type: %s" % daemon_type)
            return False

        link = link_class()
        daemon_links = getattr(self.arb.get_config(), config_attribute)
        for daemon in daemon_links:
            print("+%s+" % "-".center(86, "-"))
            print("| Config for: {0:71} |".format(daemon_type))
            print("+%s+" % "-".center(106, "-"))
            print(
                "| {0:8} | {1:30} | {2:60} |".format(
                    "Default", "Directive", "Value"
                )
            )
            print("+%s+" % "-".center(106, "-"))
            for key in link.properties:
                default = ""
                if hasattr(daemon, key):
                    value = getattr(daemon, key)
                    if isinstance(value, list):
                        values = [
                            str(item) if isinstance(item, str) else str(item.get_name())
                            for item in value
                        ]
                        text = ", ".join(values)
                    else:
                        text = str(value)
                else:
                    default = "D"
                    text = "TODO: get default value"
                if text:
                    print(
                        "| {0:8} | {1:30} | {2:60} |".format(
                            default, str(key), text
                        )
                    )
            print("+%s+" % "-".center(106, "-"))

    def do_setloglevel(self, line):
        """Change the logging level for one or all daemons."""
        self.look_connection()
        if not self.arb.reachable:
            print("Cannot connect to the arbiter, bail out")
            return

        args = line.strip().split()
        if not args or len(args) > 2:
            print("Invalid number of arguments")
            return

        daemon_name = "*" if len(args) < 2 else args[0]
        try:
            loglevel = logger.get_level_id(args[-1])
        except KeyError:
            print(
                "Invalid '%s' log level. Must be one of DEBUG, INFO, WARNING, "
                "ERROR, CRITICAL" % args[-1]
            )
            return

        conf = self.arb.get_config()
        matches = []
        for daemon_type in sat_types:
            daemon_config = getattr(conf, daemon_type + "s")
            matches.extend(
                {
                    "type": daemon_type,
                    "name": getattr(item, daemon_type + "_name"),
                    "address": item.address,
                    "port": item.port,
                }
                for item in daemon_config
                if item.alive is True
                and (
                    daemon_name == "*"
                    or getattr(item, daemon_type + "_name") == daemon_name
                )
            )

        if not matches:
            print("No daemon(s) found!")

        for match in matches:
            print("Setting loglevel %s to *%s* daemon" % (args[-1], match["name"]))
            uri = pyro.create_uri(match["address"], match["port"], "ForArbiter", False)
            conn = pyro.getProxy(uri)
            try:
                conn.set_log_level(loglevel)
            except Exception:
                print("Cannot reach %s daemon!" % match["name"])


intro = (
    "Available functions:\n"
    "# connect [localhost:7770]\n"
    "# status\n"
    "# gethostname\n"
    "# help [function]\n"
    "# showconfig [daemon type]\n"
    "# setloglevel [daemon-name] loglevel\n"
    "# quit"
)

if __name__ == "__main__":
    ShinkenAdmin().cmdloop(intro)
